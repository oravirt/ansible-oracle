delete noprompt  archivelog all backed up 1 times to disk;
{# The retention policy is part of DELETE OBSOLETE: the controlfile of a standby database
    (e.g. from RMAN DUPLICATE) does not contain the configured retention policy. #}
delete noprompt obsolete{{ (' ' ~ rman_retention_policy) if rman_retention_policy | upper != 'NONE' else '' }};
}
