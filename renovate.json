{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "branchPrefix": "pr/renovate/",
  "postUpgradeTasks": {
    "commands": [
      "tools/renovate/changelog_fragment.sh '{{{depNameSanitized}}}' '{{{depName}}}' '{{{currentVersion}}}' '{{{newVersion}}}'"
    ],
    "fileFilters": ["changelogs/fragments/renovate-*.yml"]
  },
  "ignorePaths": [
    ".ansible/**",
    ".venv/**",
    ".direnv/**",
    "context/**",
    "example/*/ansible/context/**"
  ],
  "enabledManagers": [
    "pip_requirements",
    "pep621",
    "dockerfile",
    "docker-compose",
    "pre-commit",
    "github-actions",
    "ansible-galaxy",
    "gomod",
    "custom.regex"
  ],
  "pre-commit": {
    "enabled": true
  },
  "pip_requirements": {
    "managerFilePatterns": ["/(^|/)requirements[\\w.-]*\\.txt$/"]
  },
  "constraintsFiltering": "strict",
  "packageRules": [
    {
      "description": "python of the venvs in shell.nix (python313)",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": [
        "tools/dev/requirements_dev_2.*.txt",
        "tools/dev/requirements_doctor.txt",
        "tools/dev/requirements_antsibull.txt"
      ],
      "constraints": { "python": "3.13" }
    },
    {
      "description": "python of the execution environment (python3.11) and shell.nix (python313) - lowest version",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": [
        "tools/dev/requirements_dev.txt",
        "tools/ansible/requirements_ansible.txt",
        "requirements.txt",
        "example/*/ansible/requirements.txt"
      ],
      "constraints": { "python": "3.11" }
    },
    {
      "description": "SLES15SP* and OL versions are intentionally pinned",
      "matchFileNames": [
        "docker/molecule/Dockerfile-SLES15SP*",
        "docker/molecule/Dockerfile-ol*"
      ],
      "enabled": false
    },
    {
      "description": "ansible-core is intentionally pinned per venv",
      "matchPackageNames": ["ansible-core"],
      "enabled": false
    },
    {
      "description": "version ranges in galaxy.yml are set intentionally (requires_ansible, see tools/renovate/galaxy_requires.py)",
      "matchManagers": ["ansible-galaxy"],
      "matchPackageNames": ["community.general", "community.crypto"],
      "enabled": false
    },
    {
      "description": "version of the own collection in requirements.yml is set by tools/release/galaxy_version.sh",
      "matchManagers": ["ansible-galaxy"],
      "matchPackageNames": ["opitzconsulting.ansible_oracle"],
      "enabled": false
    },
    {
      "description": "ansible-doctor: same version in requirements and pre-commit (workflow uses requirements_doctor.txt)",
      "matchPackageNames": ["ansible-doctor", "thegeeklab/ansible-doctor"],
      "groupName": "ansible-doctor"
    },
    {
      "description": "ansible-doctor requires Python <3.15",
      "matchFileNames": [".github/workflows/ansible-doctor.yml"],
      "matchDepNames": ["python"],
      "allowedVersions": "<3.15"
    },
    {
      "description": "ansible-lint: same version in requirements, pre-commit and workflow",
      "matchPackageNames": ["ansible-lint", "ansible-community/ansible-lint", "ansible/ansible-lint"],
      "groupName": "ansible-lint"
    },
    {
      "description": "black: same version in pre-commit and workflow python-lint.yml",
      "matchPackageNames": ["black", "python/black"],
      "groupName": "black"
    },
    {
      "description": "antsibull-changelog: same version in requirements, pre-commit and workflow",
      "matchPackageNames": ["antsibull-changelog", "ansible-community/antsibull-changelog"],
      "groupName": "antsibull-changelog"
    },
    {
      "description": "Docsy: theme and dependencies module together (website/go.mod), check the copied templates with 'task website:docsy:diff'",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/google/docsy", "github.com/google/docsy/dependencies"],
      "groupName": "docsy",
      "enabled": true,
      "prBodyNotes": [
        "**Docsy update needs manual steps before merge** (see `doc/website.adoc`, section *Updates of hugo and Docsy*): `task website:clean:all`, `task website:docsy:diff` and apply the changes to `website/layouts/`, check `website/assets/scss/_styles_project.scss`, `task website:test:all`."
      ]
    },
    {
      "description": "Docsy >= 0.16 is a different module (github.com/docsy/docsy/theme) with Bootstrap and Font Awesome from npm: needs a migration of website/, not a version update",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/google/docsy"],
      "allowedVersions": "<0.16.0"
    },
    {
      "description": "python-oracledb in role pyoracledb: renovate does not check requires_python",
      "matchPackageNames": ["oracledb"],
      "prBodyNotes": [
        "**pyoracledb:** check `requires_python` of the new version on PyPI. If a Python version is no longer supported, add `pyoracledb_version_py<major><minor>` with the last supported release to `roles/pyoracledb/defaults/main.yml`."
      ]
    },
    {
      "description": "website/go.mod: the go directive is not used by hugo",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "enabled": false
    },
    {
      "description": "ocenv (roles/oradb_manage_db/files/ocenv) from opitzconsulting/oracle-scripts: the file is part of the collection, tools/renovate/ocenv_update.sh replaces it and updates tools/renovate/ocenv.version",
      "matchDatasources": ["custom.ocenv"],
      "separateMajorMinor": false,
      "postUpgradeTasks": {
        "commands": [
          "tools/renovate/ocenv_update.sh '{{{newVersion}}}'",
          "tools/renovate/changelog_fragment.sh '{{{depNameSanitized}}}' '{{{depName}}}' '{{{currentVersion}}}' '{{{newVersion}}}'"
        ],
        "fileFilters": [
          "roles/oradb_manage_db/files/ocenv",
          "tools/renovate/ocenv.version",
          "changelogs/fragments/renovate-*.yml"
        ]
      }
    }
  ],
  "customManagers": [
    {
      "description": "Container images in molecule scenarios",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)molecule/[^/]+/molecule\\.ya?ml$/"],
      "matchStrings": [
        "(?:^|\\n)\\s*image:\\s*\"?(?:\\$\\{[A-Z_]+:-)?(?<depName>[a-z0-9./_-]+):(?<currentValue>[\\w.-]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Base image of ansible-builder execution environments",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)execution-environment\\.ya?ml$/"],
      "matchStrings": [
        "base_image:\\s*\\n\\s*name:\\s*\"?(?<depName>[a-z0-9./_-]+):(?<currentValue>[\\w.-]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "pip install with pinned version in github workflows",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "pip install (?<depName>[A-Za-z0-9._-]+)==(?<currentValue>[\\w.-]+)"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "description": "Versions in role defaults with a '# renovate: datasource=... depName=...' comment above",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)roles/[^/]+/defaults/main\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*[a-z0-9_]+:\\s*['\"]?(?<currentValue>[\\w.-]+)"
      ]
    },
    {
      "description": "Versions in github workflows with a '# renovate: datasource=... depName=...' comment above (e.g. 'version:' of psf/black), more comment lines between are allowed",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n(?:\\s*#.*\\n)*\\s*[A-Za-z0-9_-]+:\\s*['\"]?(?<currentValue>[\\w.-]+)"
      ]
    },
    {
      "description": "Versions in Taskfiles with a '# renovate: datasource=... depName=...' comment above",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Taskfile\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*[A-Z0-9_]+:\\s*['\"]?(?<currentValue>[\\w.-]+)"
      ]
    },
    {
      "description": "ocenv from opitzconsulting/oracle-scripts: version is the committer date of the last commit of ocenv (see tools/renovate/ocenv.version)",
      "customType": "regex",
      "managerFilePatterns": ["/^tools/renovate/ocenv\\.version$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\nversion:\\s*(?<currentValue>[0-9.]+)"
      ],
      "versioningTemplate": "loose"
    },
    {
      "description": "Oracle Release Update in 'patch: RU:<version>' of autoupgrade_download_patches with a '# renovate: datasource=custom.oracle-ru-... depName=...' comment above (also commented out patch lines)",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)autoupgrade\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*#?\\s*patch:\\s*['\"]?RU:(?<currentValue>[0-9.]+)"
      ],
      "versioningTemplate": "loose"
    }
  ],
  "customDatasources": {
    "ocenv": {
      "description": "Commits of ocenv in opitzconsulting/oracle-scripts, version is the committer date in UTC (YYYY.MMDD.HHMMSS)",
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/opitzconsulting/oracle-scripts/commits?path=ocenv&sha=main&per_page=100",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": [$.{ \"version\": $fromMillis($toMillis(commit.committer.date), '[Y0001].[M01][D01].[H01][m01][s01]'), \"releaseTimestamp\": commit.committer.date, \"changelogUrl\": html_url }] }"
      ]
    },
    "oracle-ru-19": {
      "description": "Oracle 19c Release Update derived from the quarterly Critical Patch Updates in the Oracle Security Alerts feed: one RU per CPU, Jan 2019 = 19.2",
      "defaultRegistryUrlTemplate": "https://www.oracle.com/ocom/groups/public/@otn/documents/webcontent/rss-otn-sec.xml",
      "format": "plain",
      "transformTemplates": [
        "{ \"releases\": releases[$contains(version, /<guid[^>]*>CPU(Jan|Apr|Jul|Oct)20[0-9]{2}</)].( $m := $match(version, /CPU(Jan|Apr|Jul|Oct)(20[0-9]{2})/); $q := $lookup({\"Jan\": 0, \"Apr\": 1, \"Jul\": 2, \"Oct\": 3}, $m.groups[0]); $n := ($number($m.groups[1]) - 2019) * 4 + $q + 2; $n >= 2 ? { \"version\": \"19.\" & $string($n) } : undefined ) }"
      ]
    },
    "oracle-ru-26": {
      "description": "Oracle 26ai Release Update derived from the quarterly Critical Patch Updates in the Oracle Security Alerts feed: fixed prefix 23.26, one RU per CPU, Oct 2025 = 23.26.0",
      "defaultRegistryUrlTemplate": "https://www.oracle.com/ocom/groups/public/@otn/documents/webcontent/rss-otn-sec.xml",
      "format": "plain",
      "transformTemplates": [
        "{ \"releases\": releases[$contains(version, /<guid[^>]*>CPU(Jan|Apr|Jul|Oct)20[0-9]{2}</)].( $m := $match(version, /CPU(Jan|Apr|Jul|Oct)(20[0-9]{2})/); $q := $lookup({\"Jan\": 0, \"Apr\": 1, \"Jul\": 2, \"Oct\": 3}, $m.groups[0]); $n := ($number($m.groups[1]) - 2025) * 4 + $q - 3; $n >= 0 ? { \"version\": \"23.26.\" & $string($n) } : undefined ) }"
      ]
    }
  }
}
