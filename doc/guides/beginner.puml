@startuml
!include <C4/C4_Component>

LAYOUT_TOP_DOWN()

AddContainerTag("oradb", $legendText="Database")
AddContainerTag("media", $legendText="Installation Media")
AddContainerTag("ansible", $bgColor="DarkBlue", $legendText="Ansible")

Person(admin, "Administrator")
System_Ext(mos, "My Oracle Support", "Gold Image 26ai")

System_Boundary(host, "Ansible Controller", "Ubuntu on WSL2 (Windows)") {
  Container(ansible, "Ansible", "ansible-playbook playbooks/do_all.yml", $tags="ansible")
}

System_Boundary(vmhost, "Hypervisor", "e.g. Hyper-V") {
  System(dbfs, "VM Database Server", "Inventory: beginner-dbfs\nansible_host: 192.168.66.161\nOracle Linux 9\nrecommended: 8GB RAM, 2 vCPUs") {
    Container(autoupgrade, "AutoUpgrade", "autoupgrade.jar -patch -mode download\nJDK, pexpect", $tags="ansible")
    Container(instmedia, "Installation Media", "/u01/sw/db_home_26.xx.zip", $tags="media")
    SetPropertyHeader("Parameter","Value")
    AddProperty("ORACLE_BASE", "/u01/app/oracle")
    AddProperty("ORACLE_HOME", "/u01/app/oracle/product/db26_si_ee")
    AddProperty("ORACLE_SID", "DB1")
    AddProperty("db_create_file_dest", "/u02/oradata")
    AddProperty("db_recovery_file_dest", "/u02/fra")
    ContainerDb(rdbms, "Oracle AI Database 26ai", "CDB DB1, PDB ORCLPDB", $tags="oradb")
  }
}

Rel_Down(admin, ansible, "ansible-playbook")
Rel_Down(ansible, dbfs, "ssh: os, autoupgrade, single_instance_fs")
Rel(autoupgrade, mos, "download")
Rel(autoupgrade, instmedia, "")
Rel(instmedia, rdbms, "install")

SHOW_LEGEND()
@enduml
