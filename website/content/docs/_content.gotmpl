{{/*
  Creates the documentation pages from ../doc and ../roles without copying them.
  Both directories are mounted below assets/ in hugo.yaml.
*/}}

{{/* glob below assets/ => section below /docs/ */}}
{{ $rules := slice
  (dict "glob" "doc/featurelist.adoc" "section" "features")
  (dict "glob" "doc/guides/*.adoc" "section" "guides")
  (dict "glob" "doc/README-ansible.adoc" "section" "guides")
  (dict "glob" "doc/vagrant.adoc" "section" "legacy/vagrant")
  (dict "glob" "doc/vagrant_basics.md" "section" "legacy/vagrant")
  (dict "glob" "doc/development.adoc" "section" "development")
  (dict "glob" "doc/website.adoc" "section" "development")
  (dict "glob" "doc/roles.adoc" "section" "roles")
  (dict "glob" "roles/*/README.md" "section" "roles")
}}

{{/*
  Optional settings per source file (key in lower case):
  title  - page title, the first heading stays in the content
  slug   - last part of the URL (default: file name, directory name for README.md)
  weight - order in the navigation (default: 100)
  aliases - old URLs, redirected to the page (after a move to another section)
  section - section below /docs/ instead of the section of the rule (e.g. "legacy" for an outdated guide)
*/}}
{{ $settings := dict
  "doc/featurelist.adoc" (dict "weight" 10)
  "doc/guides/breaking_changes.adoc" (dict "section" "features" "weight" 20 "aliases" (slice "/docs/guides/breaking_changes/"))
  "doc/guides/beginner.adoc" (dict "section" "examples" "weight" 10 "aliases" (slice "/docs/guides/beginner/"))
  "doc/guides/advanced.adoc" (dict "section" "legacy" "weight" 20 "aliases" (slice "/docs/guides/advanced/"))
  "doc/readme-ansible.adoc" (dict "section" "legacy" "slug" "ansible-container" "weight" 30 "aliases" (slice "/docs/guides/ansible-container/"))
  "doc/guides/local-install-howto.adoc" (dict "section" "legacy" "weight" 40 "aliases" (slice "/docs/guides/local-install-howto/"))
  "doc/guides/install-and-patch-settings.adoc" (dict "section" "guides/patching" "weight" 10 "aliases" (slice "/docs/guides/install-and-patch-settings/"))
  "doc/guides/ahf.adoc" (dict "weight" 105)
  "doc/guides/apex_ords.adoc" (dict "weight" 110)
  "doc/guides/autoupgrade.adoc" (dict "section" "guides/patching" "weight" 20 "aliases" (slice "/docs/guides/autoupgrade/"))
  "doc/guides/autoupgrade_upgrade.adoc" (dict "section" "guides/patching" "weight" 30 "aliases" (slice "/docs/guides/autoupgrade_upgrade/"))
  "doc/guides/out_of_place_patching.adoc" (dict "section" "guides/patching" "weight" 40 "aliases" (slice "/docs/guides/out_of_place_patching/"))
  "doc/guides/rman.adoc" (dict "section" "guides/rman-standby" "weight" 10 "aliases" (slice "/docs/guides/rman/"))
  "doc/guides/standby_databases.adoc" (dict "section" "guides/rman-standby" "weight" 20 "aliases" (slice "/docs/guides/standby_databases/"))
  "doc/guides/dataguard.adoc" (dict "section" "guides/rman-standby" "weight" 30 "aliases" (slice "/docs/guides/dataguard/"))
  "doc/guides/restart_rac.adoc" (dict "weight" 100)
  "doc/vagrant.adoc" (dict "title" "Vagrant on Windows" "slug" "windows" "weight" 10 "aliases" (slice "/docs/guides/vagrant/windows/"))
  "doc/vagrant_basics.md" (dict "title" "Vagrant Basics" "weight" 20 "aliases" (slice "/docs/guides/vagrant/vagrant_basics/"))
  "doc/development.adoc" (dict "title" "How to develop" "weight" 10)
  "doc/website.adoc" (dict "title" "Website" "weight" 20)
  "doc/roles.adoc" (dict "title" "Overview" "slug" "overview" "weight" 1)
}}

{{ $repo := "https://github.com/oravirt/ansible-oracle/blob/master/" }}

{{/* 1st pass: source file => page, needed to rewrite the links between the documents */}}
{{ $urls := newScratch }}
{{ $pages := slice }}
{{ range $rule := $rules }}
  {{ range resources.Match $rule.glob }}
    {{ $src := strings.TrimPrefix "/" .Name }}
    {{ $cfg := index $settings (lower $src) | default dict }}
    {{ $slug := path.BaseName $src | lower }}
    {{ if eq (path.Base $src) "README.md" }}
      {{ $slug = path.Base (path.Dir $src) }}
    {{ end }}
    {{ $path := printf "%s/%s" ($cfg.section | default $rule.section) ($cfg.slug | default $slug) }}
    {{ $urls.SetInMap "urls" (lower $src) (printf "/docs/%s/" $path) }}
    {{ $pages = $pages | append (dict "res" . "src" $src "path" $path "cfg" $cfg) }}
  {{ end }}
{{ end }}

{{/* 2nd pass: create the pages */}}
{{ range $p := $pages }}
  {{ $raw := $p.res.Content }}
  {{ $isMD := eq (path.Ext $p.src) ".md" }}

  {{ $title := $p.cfg.title }}
  {{ if not $title }}
    {{ $m := findRESubmatch `(?m)^(=+|#+)\s+(.+)$` $raw 1 }}
    {{ if $m }}
      {{ $title = index $m 0 2 }}
      {{ $level := len (index $m 0 1) }}
      {{ $siblings := findRE (printf `(?m)^(?:={%d}|#{%d})\s` $level $level) $raw 2 }}
      {{/* '= x' or the only heading of its level => it is the page title, so drop it from the body */}}
      {{ if or (eq $level 1) (eq (len $siblings) 1) }}
        {{ $raw = replaceRE `(?m)^(?:=+|#+)\s+.+\n` "" $raw 1 }}
        {{/* title was '== x' => shift the following sections up, so the page starts with h2 */}}
        {{ if and (not $isMD) (gt $level 1) }}
          {{ $raw = printf ":leveloffset: %d\n%s" (sub 1 $level) $raw }}
        {{ end }}
      {{ end }}
    {{ else }}
      {{ $title = path.BaseName $p.src }}
    {{ end }}
  {{ end }}

  {{/* relative links (not "/", "#", "{attribute}" or with ":" like https:): page on the website or file on GitHub */}}
  {{ $re := cond $isMD `\]\(([^)#\s:/{][^)#\s:]*)(#[^)]*)?\)` `link:([^\[\s:#/{][^\[\s:#]*)(#[^\[]*)?\[` }}
  {{ range findRESubmatch $re $raw }}
    {{ $target := path.Join (path.Dir $p.src) (index . 1) }}
    {{ $url := index ($urls.Get "urls") (lower $target) | default (printf "%s%s" $repo $target) }}
    {{ $new := cond $isMD (printf "](%s%s)" $url (index . 2)) (printf "link:%s%s[" $url (index . 2)) }}
    {{ $raw = replace $raw (index . 0) $new }}
  {{ end }}

  {{/* hugo would use the git info of this file => last commit of the source from data/gitinfo.json (scripts/gitinfo.py) */}}
  {{ $git := index (hugo.Data.gitinfo | default dict) (lower $p.src) }}
  {{ $page := dict
    "path" $p.path
    "title" $title
    "weight" ($p.cfg.weight | default 100)
    "params" (dict
      "github_subdir" "/"
      "path_base_for_github_subdir" (dict "from" "^.*$" "to" $p.src)
      "source_git" ($git | default false)
    )
    "content" (dict "mediaType" (cond $isMD "text/markdown" "text/asciidoc") "value" $raw)
  }}
  {{ with $p.cfg.aliases }}
    {{ $page = merge $page (dict "aliases" .) }}
  {{ end }}
  {{ with $git }}
    {{ $page = merge $page (dict "dates" (dict "lastmod" (time.AsTime .date))) }}
  {{ end }}
  {{ $.AddPage $page }}
{{ end }}

{{/*
  Examples: one page per directory in ../example (mounted below assets/example, see hugo.yaml)
  with the committed files (data/gitinfo.json) as code blocks.
  Optional settings per directory: title, weight, guide (source of the guide, which uses the example), description,
  section (default: examples) and slug (default: directory name)
  No "Edit this page" links (github_repo ""): the page is a directory, not a file.
*/}}
{{ $examples := dict
  "beginner" (dict "title" "Beginner Example" "weight" 5 "section" "legacy" "slug" "example-beginner" "guide" "doc/guides/beginner.adoc"
    "description" "Single instance database on file system with one Oracle Linux VM.")
  "dataguard" (dict "title" "Data Guard" "weight" 20 "guide" "doc/guides/dataguard.adoc"
    "description" "Primary and standby database with Data Guard on 2 Oracle Linux VMs.")
  "beginner_patching" (dict "title" "Beginner with Patching" "weight" 15
    "description" "Single instance database on file system with patches, APEX and ORDS on a Vagrant VM.")
  "rac" (dict "title" "RAC Example" "weight" 40 "section" "legacy" "slug" "example-rac"
    "description" "Oracle Grid Infrastructure and RAC database on 2 Vagrant VMs.")
}}
{{ $gitinfo := hugo.Data.gitinfo | default dict }}
{{ $lang := dict ".yml" "yaml" ".cfg" "ini" ".txt" "text" "" "ruby" }}
{{ $byExample := dict }}
{{ range resources.Match "example/**" }}
  {{ $src := strings.TrimPrefix "/" .Name }}
  {{ $git := index $gitinfo (lower $src) }}
  {{ if $git }}
    {{ $name := index (split $src "/") 1 }}
    {{ $byExample = merge $byExample (dict $name ((index $byExample $name | default slice) | append (dict "res" . "src" $src "git" $git))) }}
  {{ end }}
{{ end }}

{{ range $name, $files := $byExample }}
  {{ $cfg := index $examples $name | default dict }}
  {{ $dir := printf "example/%s" $name }}
  {{ $md := "" }}
  {{ with $cfg.description }}{{ $md = printf "%s\n\n" . }}{{ end }}
  {{ with $cfg.guide }}
    {{ with index ($urls.Get "urls") (lower .) }}
      {{ $md = printf "%sThe example is described step by step in the [guide](%s).\n\n" $md . }}
    {{ end }}
  {{ end }}
  {{ $md = printf "%sSource: [`%s`](https://github.com/oravirt/ansible-oracle/tree/master/%s)\n\n## Files\n" $md $dir $dir }}
  {{ $newest := dict "date" "" }}
  {{ range sort $files "src" }}
    {{ $file := strings.TrimPrefix (printf "%s/" $dir) .src }}
    {{ $md = printf "%s\n### %s\n\n````%s\n%s\n````\n" $md $file (index $lang (path.Ext .src) | default "text") (strings.TrimRight "\n" .res.Content) }}
    {{ if gt .git.date $newest.date }}{{ $newest = .git }}{{ end }}
  {{ end }}
  {{ $page := dict
    "path" (printf "%s/%s" ($cfg.section | default "examples") ($cfg.slug | default $name))
    "title" ($cfg.title | default $name)
    "weight" ($cfg.weight | default 100)
    "params" (dict
      "github_repo" ""
      "source_git" $newest
    )
    "dates" (dict "lastmod" (time.AsTime $newest.date))
    "content" (dict "mediaType" "text/markdown" "value" $md)
  }}
  {{ $.AddPage $page }}
{{ end }}
